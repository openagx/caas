# Runtime profile
NODE_ENV=production

# API gateway
API_PORT=3001
AUTH_ENABLED=true
REQUEST_TIMEOUT_MS=3000
FRAUD_RETRY_ATTEMPTS=2
RATE_LIMIT_MAX=250
RATE_LIMIT_WINDOW=1 minute
LOGTO_ENDPOINT=https://logto.example.com
LOGTO_RESOURCE=https://api.caas.example.com

# Internal service endpoints
ENTITY_ENDPOINT=entity-service:50052
AUTHZ_ENDPOINT=authz-engine:50051
TRUST_ENDPOINT=trust-engine:50053
FRAUD_URL=http://fraud-pipeline:50054
DECISION_ENDPOINT=decision-service:50055
FEDERATION_ENDPOINT=federation-service:50056
SURPLUS_ENDPOINT=surplus-engine:50057
DID_ENDPOINT=did-service:50058

# Data and infra (used by other services)
DATABASE_URL=postgres://caas:replace_me@postgres:5432/caas
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=redpanda:9092
SPICEDB_ENDPOINT=spicedb:50051
SPICEDB_PRESHARED_KEY=replace_me
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_me
DID_KEY_ENCRYPTION_KEY=replace_with_64_byte_hex_string
